# Copy to .env next to docker-compose.hosted.yml on the server.
# The domain must already point to the server's IP.
DOMAIN=xdm-scout.example.com
# Random hex keeps the database URL valid: openssl rand -hex 16
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Encrypts the X tokens and the keys saved in the app. Keep it only here: openssl rand -base64 32
TOKEN_KEY=
# Sent to the owner; claims the deploy once (owner sets a password), then has no use: openssl rand -hex 12
INVITE_CODE=
# Image tag from GHCR: dev, or a version tag.
APP_TAG=dev
