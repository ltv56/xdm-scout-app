# Copy to .env next to docker-compose.hosted.yml on the server.
# The domain must already point to the server's IP.
DOMAIN=xdm-scout.example.com
# Random hex keeps the database URL valid: openssl rand -hex 16
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Image tag from GHCR: dev, or a version tag.
APP_TAG=dev
